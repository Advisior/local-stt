# CPython build bundled as the Local-STT standalone runtime (#63).
# Read by scripts/build-runtime.sh as plain KEY=VALUE lines, never sourced.
#
# Source of the checksum: crates/uv-python/download-metadata.json in the uv
# 0.11.32 sdist on PyPI (the table uv itself verifies downloads against).
# To move to a newer build, take the aarch64-apple-darwin
# install_only_stripped entry from that file or from the release's SHA256SUMS
# and update all four values together.
PBS_RELEASE=20260718
PYTHON_VERSION=3.12.13
PBS_ASSET=cpython-3.12.13+20260718-aarch64-apple-darwin-install_only_stripped.tar.gz
PBS_SHA256=9a1e9e06175c10efd8378b904b07fa21bd791ab3345d7cdffeb4a76c9ff55903
